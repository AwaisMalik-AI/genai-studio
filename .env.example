# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://genai:genai@localhost:5432/genai_studio

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# Security — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# LLM (text, moderation, prompt tools)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-openai-key

# Image generation (separate from LLM if needed)
IMAGE_GEN_PROVIDER=openai_dalle
IMAGE_GEN_API_KEY=
# For Replicate: set model version id from replicate.com
REPLICATE_MODEL_VERSION=

# Celery (optional; defaults to REDIS_URL)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Storage for generated assets
STORAGE_PATH=./storage/generated

CONTENT_MODERATION_ENABLED=true
MAX_BATCH_SIZE=50
LOG_LEVEL=INFO
DEBUG=false
